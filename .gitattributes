# Normalise line endings across platforms
* text=auto

*.R      text
*.r      text
*.py     text
*.md     text
*.txt    text
*.csv    text
*.tsv    text
*.cff    text
*.yml    text
*.yaml   text

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tif    binary
*.tiff   binary
*.pdf    binary
*.zip    binary
*.gz     binary
